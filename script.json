{
  "id": "chaoxing",
  "name": "超星学习通",
  "version": "3.1.3",
  "author": "CometNetworkStudio (fork of Samueli924/chaoxing, GPL-3.0)",
  "runtime": "python3",
  "entry": "omnitask_entry.py",
  "args": [],
  "requires": [
    "requests",
    "pyaes",
    "beautifulsoup4",
    "lxml",
    "loguru",
    "celery",
    "flask",
    "fonttools",
    "openai",
    "tqdm",
    "httpx",
    "urllib3",
    "chardet",
    "ddddocr",
    "tenacity",
    "omnitask-sdk"
  ],
  "progress_regex": "(\\d{1,3})%",
  "actions": [
    {
      "id": "study",
      "name": "刷课(任务点)"
    },
    {
      "id": "learning_count",
      "name": "增加章节学习次数"
    }
  ],
  "credentials": [
    {
      "key": "username",
      "label": "手机号",
      "type": "text"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password"
    }
  ],
  "params": [
    {
      "key": "course_list",
      "label": "课程ID(逗号分隔，空=全部)",
      "type": "text",
      "default": ""
    },
    {
      "key": "speed",
      "label": "视频倍速(1-2)",
      "type": "number",
      "default": 1
    },
    {
      "key": "jobs",
      "label": "并发章节数",
      "type": "number",
      "default": 4
    },
    {
      "key": "notopen_action",
      "label": "关闭任务点处理(retry/continue)",
      "type": "text",
      "default": "retry"
    },
    {
      "key": "target_count",
      "label": "目标学习次数(learning_count)",
      "type": "number",
      "default": 100
    },
    {
      "key": "tiku_provider",
      "label": "题库 provider(可选)",
      "type": "text",
      "default": ""
    },
    {
      "key": "tiku_token",
      "label": "题库 token(可选)",
      "type": "password",
      "default": ""
    },
    {
      "key": "tiku_submit",
      "label": "题库自动提交(true/false)",
      "type": "text",
      "default": "false"
    }
  ],
  "discovery": {
    "label": "课程",
    "columns": [
      {
        "key": "course_id",
        "label": "课程ID",
        "type": "text"
      },
      {
        "key": "title",
        "label": "课程名",
        "type": "text"
      },
      {
        "key": "clazz_id",
        "label": "班级ID",
        "type": "text"
      }
    ],
    "actions": [
      "study",
      "learning_count"
    ],
    "param_map": {
      "course_list": "course_id"
    }
  }
}
